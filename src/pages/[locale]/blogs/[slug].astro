---
import BlogPostPage from '@/components/pages/BlogPostPage.astro';
import { getAllPosts, getPostBySlug } from '@/lib/content/blog';
import { resolveLocale } from '@/lib/i18n';
import { LOCALE_ROUTE_SEGMENTS } from '@/lib/astro/paths';

export async function getStaticPaths() {
  const paths = [];
  for (const routeLocale of LOCALE_ROUTE_SEGMENTS) {
    const locale = resolveLocale(routeLocale);
    const posts = await getAllPosts(locale);
    for (const post of posts) {
      paths.push({ params: { locale: routeLocale, slug: post.slug } });
    }
  }
  return paths;
}

const routeLocale = Astro.params.locale || 'ja-JP';
const locale = resolveLocale(routeLocale);
const slug = Astro.params.slug || '';
const post = await getPostBySlug(slug, locale);
if (!post) return Astro.redirect('/404/');
const allPosts = await getAllPosts(locale);
---

<BlogPostPage post={post} allPosts={allPosts} slug={slug} routeLocale={routeLocale} />
