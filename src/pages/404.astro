---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildPageMetadata } from '@/lib/seo';
import { withBasePath } from '@/lib/url';
import { routeStatusPrimaryActionClass, routeStatusSecondaryActionClass } from '@/components/site/routeStatusStyles';

const metadata = buildPageMetadata({
  title: 'ページが見つかりません',
  description: '指定されたURLのページは移動したか、公開終了した可能性があります。',
  locale: 'ja',
  path: '/404/',
});
---

<BaseLayout metadata={metadata} lang="ja">
  <div class="mx-auto flex min-h-[65vh] w-full max-w-3xl items-center justify-center py-8 sm:py-12">
    <section class="w-full rounded-3xl border border-purple-200/70 bg-white/85 p-6 shadow-[0_24px_80px_-48px_rgba(192,132,252,0.8)] backdrop-blur-sm sm:p-10 dark:border-purple-500/40 dark:bg-[#120d21]/90 dark:shadow-[0_24px_80px_-48px_rgba(192,132,252,0.55)]">
      <div class="space-y-5">
        <p class="inline-flex items-center rounded-full border border-purple-300/60 bg-purple-100/70 px-3 py-1 text-xs font-semibold tracking-[0.2em] text-purple-700 dark:border-purple-400/40 dark:bg-purple-500/20 dark:text-purple-100">
          404 NOT FOUND
        </p>
        <h1 class="text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl dark:text-gray-100">ページが見つかりません</h1>
        <p class="text-base leading-relaxed text-gray-700 dark:text-gray-300">指定されたURLのページは移動したか、公開終了した可能性があります。</p>
        <p class="text-sm text-gray-500 dark:text-gray-400">The page may have moved or is no longer available.</p>
        <div class="flex flex-wrap gap-3">
          <a href={withBasePath('/')} class={routeStatusPrimaryActionClass}>ホームへ戻る</a>
          <a href={withBasePath('/blogs/')} class={routeStatusSecondaryActionClass}>ブログ一覧へ</a>
          <a href={withBasePath('/links/')} class={routeStatusSecondaryActionClass}>リンク一覧へ</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
